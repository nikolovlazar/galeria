{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galeria",
  "version": "0.1.0",
  "identifier": "com.nikolovlazar.galeria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "Museum-style painting wallpapers",
    "longDescription": "Galeria turns a folder of high-resolution painting scans into a living desktop: museum info plates, slow panning across wide canvases, and a distraction-free viewer.",
    "copyright": "© Lazar Nikolov",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
