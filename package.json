{
  "name": "galeria",
  "private": true,
  "version": "0.1.0",
  "description": "Museum-style painting wallpapers with info plates, slow panning and a distraction-free viewer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "icons": "rsvg-convert -w 1024 -h 1024 assets/icon.svg -o assets/icon-1024.png && tauri icon assets/icon-1024.png && rsvg-convert -w 44 -h 44 assets/tray.svg -o src-tauri/icons/tray.png",
    "app": "tauri build --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
